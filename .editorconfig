root = true

# ── All files ────────────────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = crlf
indent_style             = space
trim_trailing_whitespace = true
insert_final_newline     = true

# ── C# ───────────────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4

# Prefer modern language features
csharp_style_var_for_built_in_types                    = false : suggestion
csharp_style_var_when_type_is_apparent                 = true  : suggestion
csharp_style_var_elsewhere                             = false : suggestion
csharp_prefer_simple_using_statement                   = true  : suggestion
csharp_style_namespace_declarations                    = file_scoped : warning
csharp_style_expression_bodied_methods                 = when_on_single_line : suggestion
csharp_style_expression_bodied_properties              = when_on_single_line : suggestion
csharp_style_pattern_matching_over_is_with_cast_check  = true : warning
csharp_style_pattern_matching_over_as_with_null_check  = true : warning
csharp_style_throw_expression                          = true : suggestion
csharp_style_conditional_delegate_call                 = true : suggestion
csharp_prefer_braces                                   = when_multiline : suggestion

# Null-safety: treat nullable warnings as errors
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# Async: warn when async method lacks await
dotnet_diagnostic.CS1998.severity = warning

# Blank lines
csharp_max_blank_lines_in_declarations = 1

# Spacing
csharp_space_after_cast                                = false
csharp_space_before_open_square_brackets               = false
csharp_space_between_empty_square_brackets             = false

# Sorting: System usings first (when usings are in files — prefer GlobalUsings.cs)
dotnet_sort_system_directives_first = true

# ── JSON / YAML / XML ────────────────────────────────────────────────────────
[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

# ── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
