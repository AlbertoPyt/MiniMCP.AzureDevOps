{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Information"
    }
  },
  "AllowedHosts": "*",

  // ── Autenticación ──────────────────────────────────────���─────────────────
  // API key para los endpoints críticos: /api/accounts, /api/mcpproxy, /mcp
  // Header requerido: X-Api-Key: <clave>
  // Si está vacío, la autenticación queda deshabilitada (solo para desarrollo local).
  // Genera una clave segura con: openssl rand -base64 32
  // En producción usa variables de entorno: Auth__AdminApiKey=<clave>
  "Auth": {
    "AdminApiKey": ""
  },

  // ── Base de datos (opcional) ─────────────────────────────────────────────
  // Descomenta para activar almacenamiento en BBDD con PATs cifrados.
  // SQLite:     "ConnectionStrings": { "AccountsDb": "Data Source=accounts.db" }
  // SQL Server: "ConnectionStrings": { "AccountsDb": "Server=...;Database=...;Trusted_Connection=True" }
  // DatabaseProvider: "sqlite" | "sqlserver"
  // Clave de cifrado AES-256 (obligatoria): openssl rand -base64 32

  "Mcp": {
    "ActiveAccountId": "",
    "TargetUrl": "https://azuredevops.mcpserver.microsoft.com",
    "AccountTokens": {},
    "DbEncryptionKey": ""
  }
}
